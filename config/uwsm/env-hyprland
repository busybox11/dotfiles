# Aquamarine reads AQ_DRM_DEVICES before Hyprland config when launched via UWSM.
# https://wiki.hypr.land/Configuring/Advanced-and-Cool/Multi-GPU/
case "$(cat /etc/hostname 2>/dev/null)" in
chaeri | bitcrusher)
	if [ -e /dev/dri/amd-igpu ]; then
		export AQ_DRM_DEVICES="/dev/dri/amd-igpu:/dev/dri/nvidia-dgpu"
	fi
	;;
esac
